<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Ana aksiyon butonu (CRAFT / EQUIP gibi).
        Disabled durumda otomatik soluklaşır (Material default davranışı),
        ayrıca ch_button_disabled_* renkleriyle netleştirilir.
    -->
    <style name="Widget.CyberHarvest.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_primary_background</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:fontFamily">@font/russo_one</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- İkincil aksiyon butonu (UPGRADE gibi) - çerçeveli, dolgusuz -->
    <style name="Widget.CyberHarvest.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/btn_outlined_stroke</item>
        <item name="android:textColor">@color/btn_outlined_text</item>
        <item name="android:fontFamily">@font/russo_one</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!--
        ============================================================
        TİPOGRAFİ SİSTEMİ — sadece 2 font ailesi, tutarlı roller:
        - Display (Russo One): başlıklar, isimler, buton metinleri, rozetler
        - Body (Space Mono):   istatistikler, açıklamalar, maliyet listeleri
        ============================================================
    -->

    <style name="TextAppearance.CyberHarvest.Display" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/russo_one</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.CyberHarvest.Body" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/font_space_mono</item>
    </style>

    <!-- Glow'lu kart — MaterialCardView'ın üstüne bindirilir (bkz. item_weapon_card.xml) -->
    <style name="Widget.CyberHarvest.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/ch_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeColor">@color/ch_cyan_glow_strong</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>
