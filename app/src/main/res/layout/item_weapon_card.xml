<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/ch_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/ch_cyan_glow_strong"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Başlık satırı: silah görseli + adı + durum rozeti -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivWeaponIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_glow_cyan"
                android:contentDescription="@null"
                android:padding="8dp"
                android:scaleType="centerInside"
                tools:src="@drawable/scrap_pistol" />

            <TextView
                android:id="@+id/tvWeaponName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/russo_one"
                android:letterSpacing="0.01"
                android:textColor="@color/ch_text_primary"
                android:textSize="17sp"
                tools:text="Plasma Katana" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:fontFamily="@font/russo_one"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textSize="10sp"
                tools:text="OWNED" />

        </LinearLayout>

        <!-- Alt başlık: Level / Attack ya da NOT OWNED -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:fontFamily="@font/font_space_mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ch_accent_cyan"
            android:textSize="14sp"
            tools:text="Level 2 · Attack 24" />

        <!-- Kilitliyken görünen gereksinim listesi -->
        <TextView
            android:id="@+id/tvRequirements"
            android:fontFamily="@font/font_space_mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/ch_text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Required Reputation: 40\nRequired Kills: 5"
            tools:visibility="visible" />

        <!-- Craft / Upgrade maliyet başlığı -->
        <TextView
            android:id="@+id/tvCostTitle"
            android:fontFamily="@font/font_space_mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.05"
            android:textColor="@color/ch_text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="CRAFT COST"
            tools:visibility="visible" />

        <!-- Craft / Upgrade maliyet satırları (yeşil = yeterli, kırmızı = eksik) -->
        <TextView
            android:id="@+id/tvCostList"
            android:fontFamily="@font/font_space_mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Scrap Metal: 3 / 5\nEnergy Cell: 2 / 2"
            tools:visibility="visible" />

        <!-- Maksimum seviye rozeti -->
        <TextView
            android:id="@+id/tvMaxLevel"
            android:fontFamily="@font/font_space_mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/max_level_reached"
            android:textColor="@color/ch_accent_yellow"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Aksiyon butonları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrimaryAction"
                style="@style/Widget.CyberHarvest.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="EQUIP" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSecondaryAction"
                style="@style/Widget.CyberHarvest.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:visibility="gone"
                tools:text="UPGRADE TO LV.3"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
