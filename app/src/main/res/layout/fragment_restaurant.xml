<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ch_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->

        <TextView
            android:id="@+id/tvTitle"
            android:fontFamily="@font/russo_one"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="RESTAURANT"
            android:textColor="@color/ch_accent_cyan"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="OPEN — DAY"
            android:textColor="@color/ch_accent_green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- PLAYER -->

        <TextView
            android:id="@+id/tvPlayerStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Day 1    Money: 0 ₡    Reputation: 0"
            android:textColor="@color/ch_accent_yellow"
            android:textSize="15sp" />

        <!-- RECIPES -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="RECIPES"
            android:textColor="@color/ch_accent_cyan"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_recipe_card" />

        <TextView
            android:id="@+id/tvNoRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/recipe_none_unlocked"
            android:textColor="@color/ch_text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSelectedRecipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="SELECTED: None"
            android:textColor="@color/ch_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:enabled="false"
            android:text="COOK SELECTED" />

        <!-- PREPARED FOOD -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="PREPARED FOOD"
            android:textColor="@color/ch_accent_cyan"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFoodStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No prepared food."
            android:textColor="@color/ch_accent_green"
            android:textSize="16sp" />

        <!-- INFO -->

        <TextView
            android:id="@+id/tvRestaurantInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Restaurant ready."
            android:textColor="@color/ch_text_primary"
            android:textSize="16sp" />

        <!-- CUSTOMER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="CUSTOMER"
            android:textColor="@color/ch_accent_cyan"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="No active order."
            android:textColor="@color/ch_text_primary"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnNewCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="NEW CUSTOMER" />

        <Button
            android:id="@+id/btnServe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="SERVE" />

        <!-- REWARD -->

        <TextView
            android:id="@+id/tvReward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Last reward: 0 ₡"
            android:textColor="@color/ch_accent_green"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvReputationReward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Last reputation: +0"
            android:textColor="@color/ch_accent_yellow"
            android:textSize="15sp" />

        <!-- CLOSE -->

        <Button
            android:id="@+id/btnCloseRestaurant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"
            android:text="CLOSE RESTAURANT" />

    </LinearLayout>

</ScrollView>