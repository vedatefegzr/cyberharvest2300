<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESTAURANT"
            android:textColor="#00E5FF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="OPEN — DAY"
            android:textColor="#00FF88"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- PLAYER -->

        <TextView
            android:id="@+id/tvPlayerStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Day 1    Money: 0 ₡    Reputation: 0"
            android:textColor="#FFD740"
            android:textSize="15sp"
            android:gravity="center" />

        <!-- RECIPES -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="RECIPES"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/recipeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvSelectedRecipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="SELECTED: None"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/btnCook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="COOK SELECTED"
            android:enabled="false" />

        <!-- PREPARED FOOD -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="PREPARED FOOD"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFoodStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No prepared food."
            android:textColor="#00FF88"
            android:textSize="16sp" />

        <!-- INFO -->

        <TextView
            android:id="@+id/tvRestaurantInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Restaurant ready."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center" />

        <!-- CUSTOMER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="CUSTOMER"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No active order."
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnNewCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="NEW CUSTOMER" />

        <Button
            android:id="@+id/btnServe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="SERVE"
            android:enabled="false" />

        <!-- REWARD -->

        <TextView
            android:id="@+id/tvReward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Last reward: 0 ₡"
            android:textColor="#00FF88"
            android:textSize="15sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvReputationReward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Last reputation: +0"
            android:textColor="#FFD740"
            android:textSize="15sp"
            android:gravity="center" />

        <!-- CLOSE -->

        <Button
            android:id="@+id/btnCloseRestaurant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"
            android:text="CLOSE RESTAURANT" />

    </LinearLayout>

</ScrollView>