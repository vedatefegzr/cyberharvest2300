<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ch_surface_panel"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvPerkDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="RESTORAN SEVİYE ATLADI!"
        android:textColor="@color/ch_accent_cyan"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Bir bonus seç:"
        android:textColor="@color/ch_text_secondary"
        android:textSize="13sp" />

    <!--
        Perk kartları burada kod tarafında (PerkChoiceDialogFragment)
        programatik olarak eklenir, çünkü perk sayısı/isimleri
        RestaurantPerks.all listesinden geliyor ve sabit değil.
    -->
    <LinearLayout
        android:id="@+id/perkOptionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical" />

</LinearLayout>